<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Orleans.Chronicle.Specs</AssemblyName>
        <RootNamespace>Cratis.Orleans.Chronicle</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 test projects are executables -->
        <OutputType>Exe</OutputType>
        <!-- Test projects always target net10.0 only, also in the packaging build. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="OrleansTestKit10" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Orleans.Chronicle/Orleans.Chronicle.csproj" />
    </ItemGroup>
</Project>
