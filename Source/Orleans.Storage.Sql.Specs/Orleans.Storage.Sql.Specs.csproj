<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Orleans.Storage.Sql.Specs</AssemblyName>
        <RootNamespace>Cratis.Orleans</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <!-- The packaging build multi-targets every project in the solution, but the provider under
             specification is net10.0 only because EF Core 10 is. Without this the restore fails on a
             project reference that cannot resolve for net8.0 or net9.0, which breaks publishing. -->
        <TargetFrameworks Condition="'$(IsPackaging)' == 'true'">net10.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Orleans/Orleans.csproj" />
        <ProjectReference Include="../Orleans.Storage/Orleans.Storage.csproj" />
        <ProjectReference Include="../Orleans.Storage.Sql/Orleans.Storage.Sql.csproj" />
    </ItemGroup>
</Project>
