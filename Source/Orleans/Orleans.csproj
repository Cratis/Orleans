<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Orleans</AssemblyName>
        <RootNamespace>Cratis.Orleans</RootNamespace>
        <Description>Shared Orleans building blocks for the Cratis platform - job system, workers, typed grain keys, serializers and silo hosting tooling</Description>
        <PackageTags>orleans;jobs;grains;serializers;hosting;cratis</PackageTags>
        <RepositoryUrl>https://github.com/Cratis/Orleans</RepositoryUrl>
        <ProjectUrl>https://github.com/Cratis/Orleans</ProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <NoWarn>$(NoWarn);ORLEANS0010;CS8618</NoWarn>
        <!--
            Products built on this package run rolling upgrades with silos of two of its releases in one cluster,
            calling each other's grains. Orleans identifies a grain method on the wire by a hash of its declaring
            interface, name and parameter types, so changing a signature makes it a different method the other
            release cannot decode. OrleansContracts.txt records every grain interface, its [Version], each method's
            wire identity and every grain class. The analyzer fails the build when the source drifts from it, and the
            Grain Compatibility workflow fails when it drifts from the previous release in a way that is not additive.
            See .cratis/ai/rules/project/grain-interfaces-only-grow-within-a-major.md.
        -->
        <EnableOrleansContractsAnalyzer>true</EnableOrleansContractsAnalyzer>
        <WarningsAsErrors>$(WarningsAsErrors);ORLEANS0016;ORLEANS0017;ORLEANS0018;ORLEANS0019;ORLEANS0020;ORLEANS0021;ORLEANS0022;ORLEANS0023;ORLEANS0024;ORLEANS0025;ORLEANS0027</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Sdk" />
        <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
        <PackageReference Include="Microsoft.Orleans.Server" />
        <PackageReference Include="Microsoft.Orleans.Reminders" />
        <PackageReference Include="Orleans.Providers.MongoDB" />
        <!-- Transitive pins: Orleans.Providers.MongoDB 9.5.0 floats vulnerable SharpCompress/Snappier versions. -->
        <PackageReference Include="SharpCompress" />
        <PackageReference Include="Snappier" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Orleans.Specs" />
        <None Include="buildTransitive/Cratis.Orleans.targets" Pack="true" PackagePath="buildTransitive" Visible="false" />
        <PackageReference Include="Microsoft.Orleans.Serialization" />
        <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="Cratis.Metrics.Roslyn" PrivateAssets="all" />
        <PackageReference Include="OneOf" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Orleans.Storage/Orleans.Storage.csproj" />
    </ItemGroup>
</Project>
