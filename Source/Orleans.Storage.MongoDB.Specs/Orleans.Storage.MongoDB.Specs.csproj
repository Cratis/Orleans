<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Orleans.Storage.MongoDB.Specs</AssemblyName>
        <RootNamespace>Cratis.Orleans</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 test projects are executables -->
        <OutputType>Exe</OutputType>
        <!-- Test projects always target net10.0 only, also in the packaging build. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Moq" />
        <PackageReference Include="OrleansTestKit10" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Orleans/Orleans.csproj" />
        <ProjectReference Include="../Orleans.Storage/Orleans.Storage.csproj" />
        <ProjectReference Include="../Orleans.Storage.MongoDB/Orleans.Storage.MongoDB.csproj" />
    </ItemGroup>
</Project>
