<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Orleans.Chronicle</AssemblyName>
        <RootNamespace>Cratis.Orleans.Chronicle</RootNamespace>
        <Description>Chronicle integration for Cratis Orleans - event-sourced state machines whose model is a Chronicle read model and whose transitions are driven by Chronicle events</Description>
        <PackageTags>orleans;chronicle;event-sourcing;state-machines;grains;cratis</PackageTags>
        <RepositoryUrl>https://github.com/Cratis/Orleans</RepositoryUrl>
        <ProjectUrl>https://github.com/Cratis/Orleans</ProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <NoWarn>$(NoWarn);ORLEANS0010</NoWarn>
        <!--
            Products built on this package run rolling upgrades with silos of two of its releases in one cluster,
            calling each other's grains. Orleans identifies a grain method on the wire by a hash of its declaring
            interface, name and parameter types, so changing a signature makes it a different method the other
            release cannot decode. OrleansContracts.txt records every grain interface, its [Version], each method's
            wire identity and every grain class. The analyzer fails the build when the source drifts from it, and the
            Grain Compatibility workflow fails when it drifts from the previous release in a way that is not additive.
            See .cratis/ai/rules/project/grain-interfaces-only-grow-within-a-major.md.
        -->
        <EnableOrleansContractsAnalyzer>true</EnableOrleansContractsAnalyzer>
        <WarningsAsErrors>$(WarningsAsErrors);ORLEANS0016;ORLEANS0017;ORLEANS0018;ORLEANS0019;ORLEANS0020;ORLEANS0021;ORLEANS0022;ORLEANS0023;ORLEANS0024;ORLEANS0025;ORLEANS0027</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Sdk" />
        <PackageReference Include="Cratis.Chronicle" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <!-- Cratis.Chronicle's net9.0 assembly is compiled against System.Collections.Immutable 10 but its package does
             not declare the dependency for net9.0, where the framework only has 9. -->
        <PackageReference Include="System.Collections.Immutable" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Orleans/Orleans.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Orleans.Chronicle.Specs" />
        <InternalsVisibleTo Include="Cratis.Orleans.Chronicle.Integration" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>
</Project>
