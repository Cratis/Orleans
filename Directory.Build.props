
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>

        <!-- Debuggability -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>True</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSource>True</IncludeSource>
        <!-- Debuggability - End -->

        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>True</RunAnalyzersDuringLiveAnalysis>
        <RunAnalyzers>True</RunAnalyzers>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>

        <NoWarn>NU1507;NU1510;NU1605;MSB3277;CA1873;CA1874;CA2024;IDE0330;IDE0048;MA0158;MA0036;IDE0032;IDE0340;SA1500</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackaging Condition="'$(IsPackaging)' == ''">false</IsPackaging>
        <TargetFramework Condition="'$(IsPackaging)' != 'true'">net10.0</TargetFramework>
        <TargetFrameworks Condition="'$(IsPackaging)' == 'true'">net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <!--
        TEMPORARY - remove once Cratis.Chronicle publishes the explicit registration and fluent reactor APIs
        (Cratis/Chronicle#4297) that Cratis.Orleans.Chronicle builds on.

        Until then those packages only exist in a local, unpublished feed. Restore picks it up from the
        CRATIS_ASSURANCE_FEED environment variable, or from an .assurance-feed folder beside the checkout - one level
        up for a plain clone, two levels up for a worktree under <name>-worktrees/. Nothing is added when neither
        exists, so no machine-specific path is ever committed.
    -->
    <PropertyGroup>
        <_CratisAssuranceFeed Condition="'$(CRATIS_ASSURANCE_FEED)' != '' AND Exists('$(CRATIS_ASSURANCE_FEED)')">$(CRATIS_ASSURANCE_FEED)</_CratisAssuranceFeed>
        <_CratisAssuranceFeed Condition="'$(_CratisAssuranceFeed)' == '' AND Exists('$(MSBuildThisFileDirectory)../.assurance-feed')">$(MSBuildThisFileDirectory)../.assurance-feed</_CratisAssuranceFeed>
        <_CratisAssuranceFeed Condition="'$(_CratisAssuranceFeed)' == '' AND Exists('$(MSBuildThisFileDirectory)../../.assurance-feed')">$(MSBuildThisFileDirectory)../../.assurance-feed</_CratisAssuranceFeed>
        <RestoreAdditionalProjectSources Condition="'$(_CratisAssuranceFeed)' != ''">$(RestoreAdditionalProjectSources);$(_CratisAssuranceFeed)</RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
        <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All" />
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="All" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>
</Project>
